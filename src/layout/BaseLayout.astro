---
import '@fontsource/barlow-semi-condensed/600.css';
import '@fontsource/barlow-semi-condensed/700.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/theme.scss';
import '../styles/base.css';
import { siteConfig } from '../config/site-config';
import AnalyticsScripts from '../features/analytics/AnalyticsScripts.astro';
import BackToTopButton from '../features/back-to-top/BackToTopButton.astro';
import ContactModal from '../features/contact/ContactModal.astro';
import DetailModal from '../features/detail-modal/DetailModal.astro';
import ThemeInitScript from '../features/theme/ThemeInitScript.astro';
import SeoHead from './SeoHead.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

interface Props {
  title: string;
  description?: string;
}

const { title, description = siteConfig.description } = Astro.props;
---

<!doctype html>
<html lang="en" data-bs-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <ThemeInitScript />
    <SeoHead title={title} description={description} />
    <AnalyticsScripts />
  </head>
  <body>
    <a class="visually-hidden-focusable position-absolute m-2 p-2 bg-body" href="#main-content">
      Skip to content
    </a>
    <SiteHeader />
    <main id="main-content">
      <slot />
    </main>
    <SiteFooter />
    <ContactModal />
    <DetailModal />
    <BackToTopButton />
    <script>
      import './bootstrap-data-api.client';
    </script>
  </body>
</html>
