---
import './batch-simulation.css';
---

<div data-sequence-chart></div>
<div class="d-flex flex-wrap align-items-center gap-2 mt-3">
  <button type="button" class="btn btn-primary" data-batch-start>
    Start batch
  </button>
  <button type="button" class="btn btn-outline-secondary" data-batch-reset>
    Reset
  </button>
  <div class="form-check form-switch ms-2">
    <input class="form-check-input" type="checkbox" id="batch-repeat" data-batch-repeat checked />
    <label class="form-check-label" for="batch-repeat">
      Repeat
    </label>
  </div>
</div>
<script>
  import './batch-simulation.client';
</script>
