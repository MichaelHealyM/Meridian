---
import BatchVessel from '../../features/batch-simulation/BatchVessel.astro';
import ContactButton from '../../features/contact/ContactButton.astro';
import BrowserFrame from '../../shared/components/BrowserFrame.astro';
import type { SectionProps } from '../../shared/types';
import { complianceStandards, heroContent } from './content';

type Props = SectionProps;
const { id } = Astro.props;
---

<header id={id} class="bg-grid border-bottom py-5">
  <div class="container py-md-4">
    <div class="row align-items-center g-5">
      <div class="col-md-7">
        <h1 class="display-3 lh-1">{heroContent.headline}</h1>
        <p class="lead mt-4 text-secondary">{heroContent.introduction}</p>
        <div class="d-flex flex-wrap gap-2 mt-4">
          <a href={`#${heroContent.demoSectionId}`} class="btn btn-primary btn-lg">
            {heroContent.demoActionLabel}
          </a>
          <ContactButton class="btn btn-outline-secondary btn-lg" />
        </div>
        <div class="d-flex flex-wrap gap-2 mt-4">
          {complianceStandards.map(({ name, description }) => (
            <span
              class="badge text-bg-light border fw-normal badge-with-tooltip"
              tabindex="0"
              data-bs-toggle="tooltip"
              title={description}
            >
              {name}
            </span>
          ))}
        </div>
      </div>
      <div class="col-md-5">
        <BrowserFrame address="scada.meridian.example/MP-101">
          <div class="p-3">
            <p class="d-flex justify-content-between small text-secondary mb-2">
              <span>Media prep MP-101 (simulated)</span>
              <span class="font-monospace text-body" data-batch-status></span>
            </p>
            <BatchVessel />
          </div>
        </BrowserFrame>
      </div>
    </div>
  </div>
</header>
<script>
  import './enable-tooltips.client';
</script>
