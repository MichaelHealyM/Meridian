---
import DetailModalButton from '../../features/detail-modal/DetailModalButton.astro';
import type { SectionProps } from '../../shared/types';
import { capabilities } from './content';

type Props = SectionProps;
const { id } = Astro.props;
---

<section id={id} class="container py-5">
  <h2 class="display-6">What we deliver</h2>
  <p class="text-secondary col-md-8">One team from first drawing to release.</p>
  <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-3 mt-1">
    {capabilities.map(({ badge, title, description }) => (
      <div class="col">
        <article class="card h-100 bg-body-tertiary">
          <div class="card-body d-flex flex-column">
            <span class="badge text-bg-dark font-monospace align-self-start">{badge}</span>
            <h3 class="card-title h4 mt-3">{title}</h3>
            <p class="card-text text-secondary">{description}</p>
            <DetailModalButton
              class="btn btn-link p-0 mt-auto align-self-start"
              label="Details →"
              title={title}
              body={description}
            />
          </div>
        </article>
      </div>
    ))}
  </div>
</section>
