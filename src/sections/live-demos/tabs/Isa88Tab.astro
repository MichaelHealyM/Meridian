---
import { isa88PhysicalModel, isa88ProceduralModel, recipeTypes } from '../content';

const models = [
  { title: 'Physical model', levels: isa88PhysicalModel, indentPerLevelRem: 0.9 },
  { title: 'Procedural model', levels: isa88ProceduralModel, indentPerLevelRem: 1.5 },
];
---

<p class="text-secondary">
  ISA-88 separates <em>what</em> you make (recipes) from <em>how</em> equipment does it, so a recipe
  changes without touching PLC code.
</p>
<div class="row g-4">
  {models.map(({ title, levels, indentPerLevelRem }, modelIndex) => (
    <div class="col-md-6">
      <h3 class="h5">{title}</h3>
      <ul class="list-group">
        {levels.map(({ level, example }, depth) => (
          <li
            class="list-group-item d-flex justify-content-between align-items-center bg-body-tertiary"
            style={`padding-left: ${1 + depth * indentPerLevelRem}rem`}
          >
            <b>{level}</b>
            <span class="badge text-bg-secondary fw-normal">{example}</span>
          </li>
        ))}
      </ul>
      {modelIndex === models.length - 1 && (
        <>
          <p class="small text-secondary mt-3 mb-2">Recipe types (tap for detail):</p>
          <div class="d-flex flex-wrap gap-2">
            {recipeTypes.map(({ name, explanation, buttonClass }) => (
              <button
                type="button"
                class={`btn btn-sm ${buttonClass}`}
                data-bs-toggle="popover"
                data-bs-trigger="focus"
                data-bs-title={name}
                data-bs-content={explanation}
              >
                {name}
              </button>
            ))}
          </div>
        </>
      )}
    </div>
  ))}
</div>
<script>
  import './enable-popovers.client';
</script>
